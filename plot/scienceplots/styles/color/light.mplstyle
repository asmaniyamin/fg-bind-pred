# Light color scheme
# color-blind safe
# from Paul Tol's website: https://sronpersonalpages.nl/~pault/

# Set color cycle
axes.prop_cycle : cycler('color', ['77AADD', 'EE8866', 'EEDD88', 'FFAABB', '99DDFF', '44BB99', 'BBCC33', 'AAAA00', 'DDDDDD'])
